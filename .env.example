# ---------------------------------------------------------------
# TallerTrack — variables de entorno
# Copie este archivo a .env.local y rellene los valores.
# NUNCA suba .env.local al repositorio.
# ---------------------------------------------------------------

# URL pública del sitio (se usa en el QR del ticket y en los avisos por WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# ¡Secreta! Solo en el servidor (seed y "Restablecer demo"). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Clave AES-256 para cifrar PIN/contraseña/patrón de los equipos (64 caracteres hex).
# Genérela con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_SECRET_KEY=

# Modo demo: muestra credenciales en el login y habilita "Restablecer demo"
NEXT_PUBLIC_DEMO_MODE=true
